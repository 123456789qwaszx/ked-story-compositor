<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Vn.App.Views"
        x:Class="Vn.App.MainWindow"
        Width="1400"
        Height="880"
        MinWidth="1000"
        MinHeight="640"
        Title="ked-story-compositor">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <!-- ⛔ [새 프로젝트] · [다른 이름으로…]는 2026-10-29에 걷혔다 — 이 툴은 원고를 만들지 않고(director의 일),
                 연출 층 파일은 원고 옆 한 자리에 산다. [열기…]는 원고(.vnproject.json)를 연다. -->
            <!-- 프로젝트는 폴더다 (2026-11-04 소유자) — director와 같은 폴더를 연다. 연출이 없으면 [연출 가져오기…]로 다른
                 폴더의 연출을 복사해 오고, [🎮 게임 폴더…]는 director와 같은 runtime.target.json이다. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,16,Auto,Auto,16,Auto,Auto,Auto,16,*,Auto">
                <Button Grid.Column="0" x:Name="OpenButton" Content="열기…"
                        ToolTip.Tip="프로젝트 폴더(ked-story-director가 쓴 원고)를 고릅니다. 연출 파일은 그 옆에 섭니다." />
                <Button Grid.Column="1" x:Name="SaveButton" Content="저장" Margin="6,0,0,0" />
                <Button Grid.Column="2" x:Name="ImportLayerButton" Content="연출 가져오기…" Margin="6,0,0,0"
                        ToolTip.Tip="다른 폴더의 연출(.vncompose.json)을 이 원고 옆으로 복사해 옵니다. 원고는 건드리지 않습니다." />
                <Button Grid.Column="3" x:Name="GameFolderButton" Content="🎮 게임 폴더…" Margin="6,0,0,0"
                        ToolTip.Tip="런타임의 ChapterProgression 폴더를 고릅니다. 저장할 때마다 Yarn을 여기로도 씁니다(runtime.target.json — director도 같은 설정을 읽어 진행 JSON을 씁니다)." />

                <Button Grid.Column="5" x:Name="UndoButton" Content="실행 취소" />
                <Button Grid.Column="6" x:Name="RedoButton" Content="다시 실행" Margin="6,0,0,0" />

                <!-- ⛔ [📂 챕터진행](진행 JSON 폴더 열기)은 2026-10-29에 걷혔다 — 진행 JSON은 ked-story-director가 낸다.
                     ⚠ 셋(내보내기·CSV·양식)은 <b>한 가족</b>이라 붙여 둔다. 지금 CSV·양식은 접혀 있지만(ApplyExportChrome),
                     되살아날 때 이 무리 안에서 서야 한다. -->
                <Button Grid.Column="8" x:Name="ExportButton" Content="내보내기…" />
                <Button Grid.Column="9" x:Name="CsvExportButton" Content="CSV 내보내기…" Margin="6,0,0,0" />
                <Button Grid.Column="10" x:Name="ExportFormatsButton" Content="양식…" Margin="6,0,0,0" />

                <StackPanel Grid.Column="12" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="ProjectNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProjectPathText" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- ⚠ <b>맨 끝 열(마지막 Auto)이 이 표시의 자리다.</b> 앞에 단추를 하나
                     더하면 열이 늘고, 그때 <c>*</c>(프로젝트 이름)와 이 칸이 <b>함께</b>
                     밀려야 한다. `📂 챕터진행`을 더할 때 이름 칸만 12→13으로 옮기고 이쪽을
                     안 옮겨서, 이 글이 <b>이름 위에 겹쳐</b> 섰다(2026-08-26 소유자 보고:
                     "원래 우측상단 끝이였는데"). 열 번호는 둘이 한 쌍이다. -->
                <TextBlock Grid.Column="13"
                           x:Name="DirtyText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- 상태줄은 <b>곁눈으로 읽는 줄</b>이다 (2026-08-24 소유자: "저장했습니다,
             로드했습니다 이런 문구의 크기를 줄여줘"). 기본 글자크기(14)에 위아래 8씩
             주면 36px을 늘 차지하는데, 여기 뜨는 말은 대부분 "됐다"이고 그것은 크게
             볼 것이 아니다. 이 저장소가 곁정보에 쓰는 11로 맞춘다. -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,4"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap" />
        </Border>

        <!-- 왼쪽 기둥: 챕터 지도 (2026-11-04 소유자: "가장 좌측 탭으로 길쭉하게 빼둡시다. 접었다 폈다도 할 수 있게").
             점이 에피소드, 선이 간선, 띠가 장면 — 점을 누르면 그 씬이 무대에 오른다. 루트는 [루트] 탭에서 정하고 지도는 보여 준다. -->
        <Grid ColumnDefinitions="Auto,Auto,*">
            <DockPanel Grid.Column="0" x:Name="MapPane" Width="320">
                <Border DockPanel.Dock="Top" Padding="8,4" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="MapCollapseButton" DockPanel.Dock="Right" Content="◀" FontSize="11" MinWidth="0" Padding="6,0"
                                ToolTip.Tip="지도를 접습니다." />
                        <TextBlock DockPanel.Dock="Left" Text="챕터" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <!-- 챕터 고르기 (2026-11-04 소유자: "챕터를 지도 위쪽에서 드롭다운으로") — 무대의 챕터 선택기와 같은 것(활성 판)을 비춘다. -->
                        <ComboBox x:Name="MapChapterCombo" FontSize="11" HorizontalAlignment="Stretch" MinWidth="80"
                                  PlaceholderText="챕터 선택" />
                    </DockPanel>
                </Border>
                <views:ChapterMinimapView x:Name="Minimap" />
            </DockPanel>
            <Button Grid.Column="0" x:Name="MapExpandButton" IsVisible="False" Content="▶ 지도" FontSize="11" MinWidth="0" Padding="4,10"
                    VerticalAlignment="Stretch" ToolTip.Tip="지도를 폅니다." />
            <GridSplitter Grid.Column="1" x:Name="MapSplitter" ResizeDirection="Columns" Width="4"
                          Background="{DynamicResource ThemeBorderLowBrush}" />
            <!-- 창은 무대 하나다 (2026-10-29 — ked-story-director에서 갈라지며). 이야기의 뼈대와 대사를 쓰는
                 두 그래프(챕터 그래프 · 연출 그래프)는 director의 것이라 걷혔다. 어느 씬을 연출할지는 무대의
                 챕터 · 씬 선택기가 고른다(docs/plans/compositor-split.md C1).
                 2026-11-04: 무대 옆에 [루트] 탭 하나 — 전체 재생이 갈림마다 고를 선택지를 설문처럼 정한다. 그래프 탭은 여전히 없다. -->
            <TabControl Grid.Column="2" x:Name="WorkTabs">
                <TabItem Header="무대">
                    <views:MiniStagePreview x:Name="StagePreview" />
                </TabItem>
                <TabItem Header="루트">
                    <views:RouteSurveyView x:Name="RouteSurvey" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
