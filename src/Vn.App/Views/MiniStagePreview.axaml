<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:views="using:Vn.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.MiniStagePreview">
    <!-- 무대 프리뷰 판 — 좌: 대본 터미널, 우: 무대.
         판을 감싸는 여백이 없다 — 그래프가 시작하는 윗선과 프리뷰가 시작하는 윗선이 맞도록,
         골격이 두 그래프와 같은 [툴바 Border | 내용 | 하단 보고] 셋이다. -->
    <Grid RowDefinitions="Auto,*,Auto">
            <!-- 툴바에 제목 글줄은 없다 — 연출 이름은 씬 선택기가 말한다.
                 툴바의 치수(Border Padding 10,8 · 아래 구분선 · StackPanel Spacing=6 · 콤보 치수)는
                 ked-story-director의 두 그래프 툴바와 같은 값이다 — 두 툴을 오가는 눈이 같은 자리를 찾는다.
                 뱃지·갈래 칩도 여기 오른쪽에 산다 — 제 줄 하나를 늘 차지해 빈 줄을 남기지 않게 툴바가 품는다. -->
            <Border Grid.Row="0"
                    Padding="10,8"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="챕터"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <ComboBox x:Name="ChapterCombo" MinWidth="180" FontSize="11"
                                  ToolTip.Tip="씬 선택기가 이 챕터의 씬만 담습니다. 다른 탭의 챕터 선택과 같은 값을 봅니다." />
                        <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                    </StackPanel>
                    <!-- 간격은 StageIndicators가 마진으로 준다. 많아져 줄바꿈하면
                         툴바가 그만큼 자란다 — 드문 일이라 빈 줄을 상시로 들고 있는 것보다 낫다. -->
                    <WrapPanel Grid.Column="1"
                               x:Name="BadgeRow"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 좌: 연출 대본 텍스트 패널(위) + 선택 대상 작업대(아래) · 우: 무대.
                 무대 그리기는 StageSceneView 하나다(렌더 사본 금지).
                 터미널:작업대 영역비는 가로 스플리터 드래그로 조절한다(고정 높이 + 내부 스크롤 —
                 내용 높이에 따라 범위가 변하면 조작감이 나쁘다).
                 작업대는 <b>비어 있어도 접지 않는다</b>(접으면 클릭마다 레이아웃이 움직인다)
                 — 사람이 스플리터로 정한 비율만이 이 높이를 바꾼다. -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="380,10,*,6,340"
                  Margin="14,8,14,10">
                <Grid Grid.Column="0"
                      x:Name="LeftColumn"
                      RowDefinitions="Auto,*,8,260">
                    <!-- 씬 선택기 — 미리 다 해 둔 다음에 무대 프리뷰에서 무엇을 할지 고른다. 에피소드(📄)·커스텀 씬(✎)을
                         고르면 연출 채널이 자동으로 서고(발행·연결 전부) 터미널이 채워진다.
                         챕터 지도는 셸의 왼쪽 기둥에 있다 — 점을 누르면 같은 길이다. -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,6">
                        <ComboBox x:Name="SceneCombo"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="연출할 씬 선택 — 에피소드·커스텀 씬" />
                    </StackPanel>
                    <ContentControl Grid.Row="1"
                                    x:Name="ScriptHost" />
                    <GridSplitter Grid.Row="2"
                                  x:Name="DetailSplitter"
                                  ResizeDirection="Rows"
                                  Background="{DynamicResource ThemeBorderLowBrush}" />
                    <ScrollViewer Grid.Row="3"
                                  x:Name="DetailScroll"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="DetailHost"
                                        Margin="2,4,10,4" />
                    </ScrollViewer>
                </Grid>
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />
                <!-- 무대 + 아래 재생 줄 — 재생 컨트롤과 프레임 타임라인이
                     무대 바로 밑에 나란히 선다. -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto">
                    <ContentControl Grid.Row="0"
                                    x:Name="SceneHost" />
                    <!-- 재생 줄 높이도 고정 — 타임라인이 있는 라인과 없는 라인 사이에서
                         무대 크기가 바뀌지 않는다.

                         자리로 무게를 가른다(위치상 안 겹치게): 왼쪽은 지금 다듬는 라인의 것([▶ 라인]·
                         진행), 오른쪽 끝은 가끔 쓰는 것(노드 전체 재생·배속). 타임라인이
                         가운데를 채우며 둘을 벌려 놓는다. -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,16,*,10,Auto,14,Auto"
                          Height="34"
                          Margin="0,8,0,0">
                        <ContentControl Grid.Column="0"
                                        x:Name="PlaybackHost"
                                        VerticalAlignment="Center" />
                        <ContentControl Grid.Column="2"
                                        x:Name="TimelineHost"
                                        VerticalAlignment="Center" />
                        <!-- 라인 넘기기는 타임라인에 붙는다 —
                             고르기·속도·재생이 한 줄에 서야 손이 판을 안 가로지른다. -->
                        <ContentControl Grid.Column="4"
                                        x:Name="LineStepHost"
                                        VerticalAlignment="Center" />
                        <ContentControl Grid.Column="6"
                                        x:Name="PlaybackTrailingHost"
                                        VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="3"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ThemeBorderLowBrush}" />

                <!-- 조절창은 붙박이다 — 무대 위를 덮는 팝업이 아니라 무대 오른쪽에 상시 서는
                     제 기둥이다(챕터 그래프 · 연출 그래프처럼).
                     내용은 <b>한 함수</b>가 짓는다(StageSceneView.BuildStagePopover). -->
                <Border Grid.Column="4"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="*,Auto">
                        <ContentControl x:Name="ConsoleHost" />
                        <!-- 에셋 탐색기 자리 — 에셋을 보며 고르는
                             화면이 무대라서 여기 산다. 자리만 이 뷰가 내주고 내용(AssetExplorerView)은
                             셸이 꽂는다 — 배선이 세션·탐색기 새로 고침과 얽혀 있다. -->
                        <ContentControl Grid.Row="1" x:Name="AssetHost" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 연출 보고 — 챕터 그래프의 검증 보고와 같은 문법이다: 아래쪽에 경고로 접힌 채
                 있다가 오른쪽 펼치기 단추로 펴면 상세가 선다. 머리글이 요약
                 (반영 안 된 연출·미표시·알림 수)을 들고, 펴면 미반영 상세와 알림이 선다.
                 주의: 줄들은 SelectableTextBlock 그대로다 — 드래그가 유일한 복사 통로다.
                 주의: 머리글 높이 리소스 셋은 챕터 그래프의 것과 같은 값이다 — Fluent의
                 48px 기본을 Style로는 못 줄여 리소스를 갈아 끼운다(그쪽 주석 참조). -->
            <!-- 창 가장자리에 딱 붙는다 — 판의 바깥 여백이 없어 챕터 그래프의 검증 보고와
                 같은 자리 잡기다. -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,1,0,0">
                <Expander x:Name="StageReportExpander"
                          Header="연출 보고"
                          Padding="0"
                          FontSize="11"
                          HorizontalAlignment="Stretch">
                    <Expander.Resources>
                        <x:Double x:Key="ExpanderMinHeight">26</x:Double>
                        <Thickness x:Key="ExpanderHeaderPadding">10,2</Thickness>
                        <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                    </Expander.Resources>
                    <ScrollViewer MaxHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <StackPanel Margin="10,6" Spacing="4">
                            <StackPanel x:Name="UnhandledHost" Spacing="2" />
                            <StackPanel x:Name="NoticeHost" Spacing="2" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Border>
    </Grid>
</UserControl>
