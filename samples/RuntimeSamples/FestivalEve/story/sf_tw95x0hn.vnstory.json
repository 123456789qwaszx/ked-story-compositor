    {
      "id": "nd_5ccte9k4",
      "kind": "set",
      "name": "챕터 festival_eve 조건",
      "layout": {
        "x": 0,
        "y": 0
      },
      "conditions": [
        {
          "id": "cd_mve2qtqv",
          "name": "성실 2 이상",
          "expression": "stat(\"성실\") >= 2"
        },
        {
          "id": "cd_n4indpmw",
          "name": "요령 2 이상",
          "expression": "stat(\"요령\") >= 2"
        },
        {
          "id": "cd_6k0ncjjb",
          "name": "성실 2 미만",
          "expression": "stat(\"성실\") < 2"
        },
        {
          "id": "cd_ph2tezn2",
          "name": "요령 3 이상",
          "expression": "stat(\"요령\") >= 3"
        },
        {
          "id": "cd_cte029np",
          "name": "성실 3 이상 · 요령 3 미만",
          "expression": "stat(\"성실\") >= 3 && stat(\"요령\") < 3"
        },
        {
          "id": "cd_c07qymhp",
          "name": "성실 3 미만 · 요령 3 미만",
          "expression": "stat(\"성실\") < 3 && stat(\"요령\") < 3"
