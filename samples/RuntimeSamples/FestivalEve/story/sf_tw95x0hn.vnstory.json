      },
      "script": {
        "primaryLocale": "ko-KR",
        "sourceRevision": 1,
        "sourceContentHash": "E4891AB37B957D5242E147FB348E8C4603EFBBD96FB5E133E757221F578BF1CD",
        "lines": [
          {
            "id": "ln_pq4uwryp",
            "revision": 2
