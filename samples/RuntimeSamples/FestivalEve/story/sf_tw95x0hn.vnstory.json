          {
            "id": "ln_i48ixbjx",
            "revision": 1
          }
        ],
        "locales": [
          {
            "locale": "ko-KR",
            "entries": {
              "ln_pq4uwryp": {
                "speaker": "시구레",
                "text": "선생님이 보고 받으시고 간판 칭찬하셨어요."
              },
              "ln_i48ixbjx": {
                "speaker": "하린",
                "text": "보고하고 오길 잘했네. 아까 그 선택지 덕분이야."
              }
            }
          }
        ]
