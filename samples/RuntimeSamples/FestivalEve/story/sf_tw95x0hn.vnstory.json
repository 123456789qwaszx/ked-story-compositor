        ],
        "locales": [
          {
            "locale": "ko-KR",
            "entries": {
              "ln_m208n5x2": {
                "speaker": "카스미",
                "text": "부탁한 마무리, 다 해서 갖다 놨어."
              },
              "ln_2wwvdc98": {
                "speaker": "하린",
                "text": "카스미가 여기 있는 건 아까 그 선택지를 골랐기 때문이야."
