{
  "formatVersion": 1,
  "dialogueResults": [
    {
      "sourceNode": "nd_ushhar34",
      "sourceNodeName": "Festival_Classroom",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_b76q68hg",
          "revision": 2,
          "speaker": "하린",
          "text": "축제가 내일인데, 우리 반 간판이 아직 반쯤 비어 있어."
        },
        {
          "index": 1,
          "lineId": "ln_rxvmhx0i",
          "revision": 1,
          "speaker": "시구레",
          "text": "칠도 반쯤 말랐네요. 이대로 걸기엔 좀 애매해요."
        },
        {
          "index": 2,
          "lineId": "ln_y37h16s8",
          "revision": 1,
          "speaker": "시구레",
          "text": "글씨는 무슨 색으로 할까요?"
        },
        {
          "index": 3,
          "lineId": "ln_v25zy8n9",
          "revision": 1,
          "text": "하늘색",
          "condition": {
            "kind": "beginChoice",
            "option": "op_4p04yf14"
          }
        },
        {
          "index": 4,
          "lineId": "ln_ksq322v0",
          "revision": 1,
          "speaker": "시구레",
          "text": "하늘색이면 교실 벽이랑 잘 어울리겠어요."
        },
        {
          "index": 5,
          "lineId": "ln_0881u5vn",
          "revision": 1,
          "text": "노란색",
          "condition": {
            "kind": "beginNextOption",
            "option": "op_9bwgf8g3"
          }
        },
        {
          "index": 6,
          "lineId": "ln_gathtysb",
          "revision": 1,
          "speaker": "시구레",
          "text": "노란색이면 복도 끝에서도 보이겠네요."
        },
        {
          "index": 7,
          "lineId": "ln_q1me6jy8",
          "revision": 1,
          "speaker": "하린",
          "text": "문제는 시간이야. 처음부터 다시 그릴지, 있는 걸로 마무리할지.",
          "condition": {
            "kind": "endChoice"
          }
        },
        {
          "index": 8,
          "lineId": "ln_4i38h8b3",
          "revision": 1,
          "speaker": "하린",
          "text": "이번엔 대사 안의 선택이 아니야. 에피소드가 끝나면 진행 쪽이 묻고, 고른 쪽 스탯이 올라."
        }
      ],
      "resultId": "rs_v83rt8ht",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:82fc87cb33ebf9d04d4b1a1389c7f7aaf1f00f211d8faab1910611ba6958f73f",
      "publishedAt": "2026-11-04T08:02:43.5391292+00:00"
    },
    {
      "sourceNode": "nd_b3c35fxj",
      "sourceNodeName": "Festival_Remake",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_kdy67tc8",
          "revision": 2,
          "speaker": "하린",
          "text": "좋아, 처음부터 다시. 붓부터 새로 빨아 올게."
        },
        {
          "index": 1,
          "lineId": "ln_2ibajvnq",
          "revision": 1,
          "speaker": "시구레",
          "text": "지금 성실은 {stat(\"성실\")}점이에요. 방금 그 선택지가 올린 거예요."
        },
        {
          "index": 2,
          "lineId": "ln_prrx0d33",
          "revision": 1,
          "speaker": "시구레",
          "text": "대사는 스탯을 읽기만 해요. 바꾸는 건 진행 선택지뿐이고요."
        },
        {
          "index": 3,
          "lineId": "ln_068q2fi1",
          "revision": 1,
          "speaker": "하린",
          "text": "아직 같은 장면이라, 되감기(R)로 돌아가면 방금 선택도 다시 고를 수 있어."
        }
      ],
      "resultId": "rs_4rd0x2mw",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:dd2cf448ceb0ecb46d97afda1456b5179cdecf079013b985475e51863fca4bbd",
      "publishedAt": "2026-11-04T08:02:43.5941374+00:00"
    },
    {
      "sourceNode": "nd_8dn0igwy",
      "sourceNodeName": "Festival_Shortcut",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_jfze1fzb",
          "revision": 2,
          "speaker": "시구레",
          "text": "마른 칸은 살리고, 빈 칸만 스티커로 채워요."
        },
        {
          "index": 1,
          "lineId": "ln_rbxvmjp0",
          "revision": 1,
          "speaker": "하린",
          "text": "지금 요령은 {stat(\"요령\")}점이야. 방금 그 선택지가 올린 거지."
        },
        {
          "index": 2,
          "lineId": "ln_j1v81kqe",
          "revision": 1,
          "speaker": "하린",
          "text": "대사는 스탯을 읽기만 해. 바꾸는 건 진행 선택지뿐이야."
        },
        {
          "index": 3,
          "lineId": "ln_fih4v3qp",
          "revision": 1,
          "speaker": "시구레",
          "text": "아직 같은 장면이라, 되감기(R)로 돌아가면 방금 선택도 다시 고를 수 있어요."
        }
      ],
      "resultId": "rs_de9kw5ns",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:c1c526a2c17ac1973f922133b6fb9a2e01440f91827b3faf4f4daf5d9056cbe4",
      "publishedAt": "2026-11-04T08:02:43.6031643+00:00"
    },
    {
      "sourceNode": "nd_exq3wbfy",
      "sourceNodeName": "Festival_Wrapup",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_yfg43av8",
          "revision": 2,
          "speaker": "시구레",
          "text": "이제 교무실에 가서 간판 검사를 받아야 해요.",
          "detour": [
            "nd_25h2x841",
            "nd_xmki0c6d"
          ]
        },
        {
          "index": 1,
          "lineId": "ln_jb5v7as4",
          "revision": 1,
          "speaker": "시구레",
          "text": "이번 선택지에는 조건이 달려 있어요. 안 맞으면 숨거나, 잠긴 채로 이유가 보여요."
        }
      ],
      "resultId": "rs_enedbyxi",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:c92ccd0394723ee527298d786556f4a6410ea12ef61c6e35798503d53b2e3265",
      "publishedAt": "2026-11-04T08:02:43.6148325+00:00"
    },
    {
      "sourceNode": "nd_25h2x841",
      "sourceNodeName": "Festival_Wrapup_Remade",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_s7tk0up3",
          "revision": 2,
          "speaker": "하린",
          "text": "다시 그린 간판, 생각보다 훨씬 낫다.",
          "condition": {
            "kind": "beginIf",
            "condition": "cd_mve2qtqv",
            "name": "성실 2 이상",
            "expression": "stat(\"성실\") >= 2"
          }
        }
      ],
      "trailing": [
        {
          "kind": "endIf"
        }
      ],
      "resultId": "rs_mdvcpehb",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:2130d2806c465beb973e4b791813b6ac7c30df83734e41a9b91b7d83c08b9f76",
      "publishedAt": "2026-11-04T08:02:43.6258860+00:00"
    },
    {
      "sourceNode": "nd_xmki0c6d",
      "sourceNodeName": "Festival_Wrapup_Sticker",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_v9rdek8z",
          "revision": 2,
          "speaker": "하린",
          "text": "스티커 간판도 나름 귀엽네.",
          "condition": {
            "kind": "beginIf",
            "condition": "cd_6k0ncjjb",
            "name": "성실 2 미만",
            "expression": "stat(\"성실\") < 2"
          }
        }
      ],
      "trailing": [
        {
          "kind": "endIf"
        }
      ],
      "resultId": "rs_u9eb8nz2",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:03399a41ec34327ec9c8d14d52dc5d94829662c35817cb17cefb321328b00423",
      "publishedAt": "2026-11-04T08:02:43.6364935+00:00"
    },
    {
      "sourceNode": "nd_xfp8pum4",
      "sourceNodeName": "Festival_Staffroom",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_ngjwdzsb",
          "revision": 2,
          "speaker": "하린",
          "text": "저녁의 교무실 앞. 장면이 바뀌었어."
        },
        {
          "index": 1,
          "lineId": "ln_f70g3xzg",
          "revision": 1,
          "speaker": "시구레",
          "text": "교실 장면은 확정돼서 저장됐어요. 되감기로는 거기까지 돌아가지 않아요."
        },
        {
          "index": 2,
          "lineId": "ln_hv7zzi8m",
          "revision": 1,
          "speaker": "하린",
          "text": "대신 대사 기록에서 교실 장면의 대사를 누르면, 거기서 새 회차로 갈라져."
        },
        {
          "index": 3,
          "lineId": "ln_hb0cdhkt",
          "revision": 1,
          "speaker": "시구레",
          "text": "메뉴에서 저장하면 지금 이 자리를 슬롯에 남길 수 있어요.",
          "detour": [
            "nd_t2vv61n2",
            "nd_8dxcia1w",
            "nd_q1q036hx"
          ]
        },
        {
          "index": 4,
          "lineId": "ln_mmj0m4fe",
          "revision": 1,
          "speaker": "하린",
          "text": "내일 축제, 잘 되겠지?"
        },
        {
          "index": 5,
          "lineId": "ln_g2hh953n",
          "revision": 1,
          "speaker": "시구레",
          "text": "그럼요. 오늘은 여기까지예요."
        },
        {
          "index": 6,
          "lineId": "ln_9k3krs99",
          "revision": 1,
          "text": "캐릭터 퇴장"
        }
      ],
      "resultId": "rs_yi0am6hi",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:a54649db79e4ce8093ca0d29f3586f96f2ae8af1ee0467418a8886ed60d80471",
      "publishedAt": "2026-11-04T08:02:43.6543192+00:00"
    },
    {
      "sourceNode": "nd_t2vv61n2",
      "sourceNodeName": "Festival_Staffroom_Kasmi",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_m208n5x2",
          "revision": 2,
          "speaker": "카스미",
          "text": "부탁한 마무리, 다 해서 갖다 놨어.",
          "condition": {
            "kind": "beginIf",
            "condition": "cd_ph2tezn2",
            "name": "요령 3 이상",
            "expression": "stat(\"요령\") >= 3"
          }
        },
        {
          "index": 1,
          "lineId": "ln_2wwvdc98",
          "revision": 1,
          "speaker": "하린",
          "text": "카스미가 여기 있는 건 아까 그 선택지를 골랐기 때문이야."
        }
      ],
      "trailing": [
        {
          "kind": "endIf"
        }
      ],
      "resultId": "rs_8gmrmzci",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:ee66dd4e88edc1a8dc74a0106f6c55535f30512a17600e28e2bb90ea07175067",
      "publishedAt": "2026-11-04T08:02:43.6936226+00:00"
    },
    {
      "sourceNode": "nd_8dxcia1w",
      "sourceNodeName": "Festival_Staffroom_Praise",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_pq4uwryp",
          "revision": 2,
          "speaker": "시구레",
          "text": "선생님이 보고 받으시고 간판 칭찬하셨어요.",
          "condition": {
            "kind": "beginIf",
            "condition": "cd_cte029np",
            "name": "성실 3 이상 · 요령 3 미만",
            "expression": "stat(\"성실\") >= 3 && stat(\"요령\") < 3"
          }
        },
        {
          "index": 1,
          "lineId": "ln_i48ixbjx",
          "revision": 1,
          "speaker": "하린",
          "text": "보고하고 오길 잘했네. 아까 그 선택지 덕분이야."
        }
      ],
      "trailing": [
        {
          "kind": "endIf"
        }
      ],
      "resultId": "rs_z7sepk58",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:c872b81961b6a48548978e0df6e7444ff3a810e3e81c0f50acf6db0e5dff8e47",
      "publishedAt": "2026-11-04T08:02:43.7206435+00:00"
    },
    {
      "sourceNode": "nd_q1q036hx",
      "sourceNodeName": "Festival_Staffroom_Pass",
      "locale": "ko-KR",
      "sourceScriptRevision": 1,
      "lines": [
        {
          "index": 0,
          "lineId": "ln_as37pa6a",
          "revision": 2,
          "speaker": "시구레",
          "text": "검사는 통과예요. 이제 내일만 남았네요.",
          "condition": {
            "kind": "beginIf",
            "condition": "cd_c07qymhp",
            "name": "성실 3 미만 · 요령 3 미만",
            "expression": "stat(\"성실\") < 3 && stat(\"요령\") < 3"
          }
        }
      ],
      "trailing": [
        {
          "kind": "endIf"
        }
      ],
      "resultId": "rs_tc3vpr6f",
      "version": 1,
      "schemaVersion": 4,
      "contentHash": "sha256:716ddf1d0d843a6414fafad3694e936932ce20a5375ade6209a548c6da5c71ee",
      "publishedAt": "2026-11-04T08:02:43.7618201+00:00"
    },
